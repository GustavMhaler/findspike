# Copy to a root-readable location OUTSIDE this repository, e.g.
#   sudo cp deploy/shanzhai.env.example /etc/shanzhai.env
#   sudo chmod 600 /etc/shanzhai.env
# Then fill in the values. Referenced by the systemd units via
# EnvironmentFile=/etc/shanzhai.env.

# Where the Worker's /api/deliver endpoint lives (the public hostname).
WORKER_URL=https://shanzhai.shaojiang61.site

# Shared secret between the CLI and the Worker (POST /api/deliver).
# Generate with:  openssl rand -hex 32
DIGEST_SECRET=

# Asia/Shanghai hour (0-23) at which the merged daily CHoCH digest is sent.
# Default 8 (one digest per day); outside this hour signals accumulate silently.
DIGEST_HOUR=8

# Cloudflare Turnstile site key (public) embedded in the page's subscribe form.
TURNSTILE_SITEKEY=

# Optional: Binance API base URL override (e.g. a regional/proxy endpoint).
# Leave empty to use https://api.binance.com
BINANCE_BASE_URL=

# ---- AI review (OpenAI-compatible chat API, e.g. DeepSeek) ----
# DeepSeek defaults: base https://api.deepseek.com, model deepseek-chat
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat

# ---- Worker bindings (configure in Cloudflare, NOT here) ----
# D1 binding        : DB
# Secret            : RESEND_API_KEY  (Resend API key)
# Secret            : TURNSTILE_SECRET (Turnstile secret key, matching TURNSTILE_SITEKEY)
# Secret            : DIGEST_SECRET   (must equal DIGEST_SECRET above)
# Plain text vars   : FROM_EMAIL=desk@shanzhai.shaojiang61.site (verified sender)
# Plain text vars   : ADMIN_EMAIL=<your address>
# Plain text vars   : BASE_URL=https://shanzhai.shaojiang61.site
