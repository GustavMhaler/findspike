# Shanzhai daily scan — 06:00 Asia/Shanghai
[Unit]
Description=Shanzhai daily volume-spike scan and site build
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=shaojiang61
Group=shaojiang61
WorkingDirectory=/home/shaojiang61/web/findspike
EnvironmentFile=/etc/shanzhai.env
ExecStart=/home/shaojiang61/web/findspike/.venv/bin/python -m shanzhai.cli daily --output public --state state
Nice=5
StandardOutput=journal
StandardError=journal
