# Shanzhai CHoCH scan — 5 minutes after every 15m candle closes
[Unit]
Description=Shanzhai CHoCH 1h/15m BOS/CHoCH scan, site build and immediate signal delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=shaojiang61
Group=shaojiang61
WorkingDirectory=/home/shaojiang61/web/findspike
EnvironmentFile=/etc/shanzhai.env
ExecStart=/home/shaojiang61/web/findspike/.venv/bin/python -m shanzhai.cli choch --output public --state state
Nice=5
StandardOutput=journal
StandardError=journal
